PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-this-with-a-long-random-secret

# Set DATABASE_URL to the connection string provided by your hosted PostgreSQL service.
# Example format: postgresql://user:password@host:5432/remote_classrooms
DATABASE_URL=

# Or configure these connection fields instead of DATABASE_URL.
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=remote_classrooms

# Enable TLS for hosted PostgreSQL providers that require encrypted connections.
PGSSL=true
# Optional CA certificate (PEM) for providers that require a custom certificate.
# PGSSL_CA=

# Optional path for class recording files (defaults to backend/recordings).
# RECORDINGS_DIR=

# Used only by `npm run create-admin` to provision or reset your initial admin.
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
